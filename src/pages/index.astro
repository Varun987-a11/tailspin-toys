---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllCategories, getAllGames, getAllPublishers } from '../lib/games';

export const prerender = true;

const db = getDatabase();
const games = await getAllGames(db);
const categories = await getAllCategories(db);
const publishers = await getAllPublishers(db);
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <form class="mb-8 rounded-xl border border-slate-700 bg-slate-800/60 p-6" data-testid="game-filters">
            <div class="grid gap-6 md:grid-cols-2">
              <fieldset>
                <legend class="mb-3 text-sm font-semibold text-slate-200">Filter by category</legend>
                <div class="flex flex-wrap gap-3">
                  {categories.map((category) => (
                    <label class="flex items-center gap-2 text-sm text-slate-300">
                      <input
                        type="checkbox"
                        name="category"
                        value={category.id}
                        class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                        data-testid={`category-filter-${category.id}`}
                      />
                      <span>{category.name}</span>
                    </label>
                  ))}
                </div>
              </fieldset>

              <label class="flex flex-col gap-3 text-sm font-semibold text-slate-200">
                <span>Filter by publisher</span>
                <select
                  name="publisher"
                  class="rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 font-normal text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                  data-testid="publisher-filter"
                >
                  <option value="">All publishers</option>
                  {publishers.map((publisher) => <option value={publisher.id}>{publisher.name}</option>)}
                </select>
              </label>
            </div>

            <div class="mt-6 flex flex-wrap items-center gap-4">
              <button
                type="reset"
                class="rounded-lg border border-slate-600 px-4 py-2 text-sm font-medium text-slate-200 transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                data-testid="reset-game-filters"
              >
                Clear filters
              </button>
              <p class="text-sm text-slate-400" role="status" aria-live="polite" data-testid="filter-results-count">
                Showing {games.length} games
              </p>
            </div>
          </form>

          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="games-grid">
            {games.map((game) => <GameCard game={game} />)}
          </div>
          <div class="hidden" data-testid="filtered-empty-state">
            <EmptyState text="No games match the selected filters." />
          </div>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  const filterForm = document.querySelector<HTMLFormElement>('[data-testid="game-filters"]');
  const gameCards = [...document.querySelectorAll<HTMLElement>('[data-testid="game-card"]')];
  const resultsCount = document.querySelector<HTMLElement>('[data-testid="filter-results-count"]');
  const filteredEmptyState = document.querySelector<HTMLElement>('[data-testid="filtered-empty-state"]');

  filterForm?.addEventListener('input', () => {
    const selectedCategories = new Set(
      [...filterForm.querySelectorAll<HTMLInputElement>('input[name="category"]:checked')].map(
        (input) => input.value,
      ),
    );
    const selectedPublisher = filterForm.querySelector<HTMLSelectElement>('select[name="publisher"]')?.value ?? '';
    let visibleCount = 0;

    for (const card of gameCards) {
      const categoryMatches =
        selectedCategories.size === 0 || selectedCategories.has(card.dataset.categoryId ?? '');
      const publisherMatches =
        selectedPublisher === '' || selectedPublisher === card.dataset.publisherId;
      const isVisible = categoryMatches && publisherMatches;
      card.classList.toggle('hidden', !isVisible);
      visibleCount += isVisible ? 1 : 0;
    }

    if (resultsCount) {
      resultsCount.textContent = `Showing ${visibleCount} game${visibleCount === 1 ? '' : 's'}`;
    }
    filteredEmptyState?.classList.toggle('hidden', visibleCount !== 0);
  });

  filterForm?.addEventListener('reset', () => {
    requestAnimationFrame(() => filterForm.dispatchEvent(new Event('input')));
  });
</script>
